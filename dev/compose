#!/usr/bin/env bash
# Local development only: runs docker compose for a Backoffice started by dev/up, as its own project
# ops-backoffice-<instance> with the settings in .env.<instance>. Its database is ops_backoffice_<instance>_development
# in the portal's Postgres on localhost:5432, see docker-compose.ops-postgres.yml.
#
#   dev/compose malacky up -d      # start it again, e.g. every day
#   dev/compose malacky logs -f zammad-railsserver
#   dev/compose malacky down -v    # wipe it (and drop its database, see README.md), then run dev/up again
set -euo pipefail
cd "$(dirname "$0")/.."

instance=${1:?usage: dev/compose <instance> <docker compose arguments>}
shift
[ -f ".env.$instance" ] || { echo "No .env.$instance, start the Backoffice with dev/up first" >&2; exit 1; }

export OPS_POSTGRES_DB="ops_backoffice_${instance//-/_}_development"
exec docker compose -p "ops-backoffice-$instance" --env-file ".env.$instance" \
  -f docker-compose.yml -f docker-compose.ops-postgres.yml "$@"
